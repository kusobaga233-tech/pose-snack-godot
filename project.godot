; Engine configuration file.
; Pose Snake — Godot 4.6 native port with YoudooGame SDK body tracking.
;
; The renderer is deliberately GL Compatibility: the target box (HP52S0,
; Amlogic) has a weak GPU, and the WebView prototype proved that the frame
; budget is the hard constraint. Native 2D in GL Compatibility is the fast path.

config_version=5

[application]

config/name="PoseSnake"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.6", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

YoudooBridge="*res://src/youdoo_bridge.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
textures/default_filters/use_nearest_mipmap_filter=false
anti_aliasing/quality/msaa_2d=0
environment/defaults/default_clear_color=Color(0.02, 0.04, 0.07, 1)

[physics]

common/physics_ticks_per_second=60
2d/default_gravity=0.0

[input_devices]

pointing/emulate_touch_from_mouse=true
