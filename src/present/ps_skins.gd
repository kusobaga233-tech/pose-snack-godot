extends RefCounted
## Character skins (角色皮肤): the generated table, the atlases, the player's
## persisted choice and the per-round NPC assignment.
##
## The table itself is `ps_skin_data.gd`, generated by
## `tools/build_characters.py` from the owner's `modular_front` pack; this file
## only adds behaviour:
##
##   * load each character's atlas + body texture once, log **once** and fall
##     back to the procedural head/body for a missing or corrupt character,
##   * keep the player's choice in `user://pose_snake.cfg` (the project had no
##     settings file before this),
##   * deal the characters the player did not pick to the AI snakes **once per
##     round**: distinct among the visible snakes, stable for the whole round,
##     re-rolled on the next one.  The pool is `count() - 1` (the player's pick
##     excluded), so adding a character just widens it.
##
## Assignment is stored as `ps_skin` metadata on the snake object
## (`Object.set_meta`), so `src/core/**` stays untouched and the world view, the
## minimap and the settlement stage all read the same value.

const PSData = preload("res://src/present/ps_skin_data.gd")

const SETTINGS_PATH := "user://pose_snake.cfg"
const META := &"ps_skin"

static var ready := false
## Prepared entries: the generated dict plus `regions` (Rect2 + offset Vector2)
## and the two loaded textures.
static var skins: Array = []
## Index into `skins` of the character the player picked.
static var player_skin := 0
static var _settings_loaded := false
static var _warned: Dictionary = {}
## Number of characters that failed to load (the world view uses it once to
## decide whether it needs the procedural fallback at all).
static var missing := 0


# ------------------------------------------------------------------- loading

static func prepare() -> void:
	if ready:
		return
	ready = true
	for e in PSData.LIST:
		var s: Dictionary = e.duplicate(true)
		var regions := {}
		var rd: Dictionary = e["regions"]
		for key in rd:
			var a: Array = rd[key]
			regions[key] = {
				"r": Rect2(float(a[0]), float(a[1]), float(a[2]), float(a[3])),
				"o": Vector2(float(a[4]), float(a[5])),
			}
		s["regions"] = regions
		s["atlas_tex"] = _load_tex(String(e["atlas"]), String(e["slug"]))
		s["body_tex"] = _load_tex(String(e["body"]), String(e["slug"]))
		skins.append(s)
	load_settings()


static func _load_tex(path: String, slug: String) -> Texture2D:
	if ResourceLoader.exists(path):
		var res = load(path)
		if res is Texture2D:
			return res
	if not _warned.has(slug):
		_warned[slug] = true
		missing += 1
		print("[skin] %s: asset missing/corrupt (%s) — that snake falls back to the procedural head/body"
			% [slug, path])
	return null


static func count() -> int:
	return skins.size()


static func get_skin(i: int) -> Dictionary:
	if skins.is_empty():
		return {}
	return skins[clampi(i, 0, skins.size() - 1)]


static func index_of_slug(slug: String) -> int:
	for i in skins.size():
		if String(skins[i]["slug"]) == slug:
			return i
	return -1


static func name_of(i: int) -> String:
	var s := get_skin(i)
	return String(s.get("name", "?"))


## True when this character has both textures (otherwise: procedural fallback).
static func usable(i: int) -> bool:
	if i < 0 or i >= skins.size():
		return false
	var s: Dictionary = skins[i]
	return s.get("atlas_tex") != null and s.get("body_tex") != null


static func atlas_tex(i: int) -> Texture2D:
	return get_skin(i).get("atlas_tex")


static func body_tex(i: int) -> Texture2D:
	return get_skin(i).get("body_tex")


## Atlas texel rect of a region (`head`, `decor`, `eyes_open`, `eyes_half`,
## `eyes_closed`, `mouth_open`, `mouth_closed`, `mouth_tongue`).
static func region(i: int, key: String) -> Rect2:
	var s := get_skin(i)
	var r: Dictionary = s.get("regions", {})
	var e: Dictionary = r.get(key, {})
	return e.get("r", Rect2())


## Region top-left offset from the pack's shared head anchor (199,900), in atlas
## texels (source px * `PSData.ATLAS_K`).
static func region_off(i: int, key: String) -> Vector2:
	var s := get_skin(i)
	var r: Dictionary = s.get("regions", {})
	var e: Dictionary = r.get(key, {})
	return e.get("o", Vector2.ZERO)


static func atlas_size(i: int) -> Vector2:
	var s := get_skin(i)
	return Vector2(s.get("atlas_size", Vector2i(1, 1)))


# ------------------------------------------------------------ snake tagging

static func of(s) -> int:
	if s == null:
		return -1
	return int(s.get_meta(META, -1))


static func set_of(s, idx: int) -> void:
	if s == null:
		return
	s.set_meta(META, idx)


## Deal the characters the player did not pick to the field.
##
## The pool is every skin except `player_skin` (`count() - 1` entries), so 7 AI
## and a 2P partner always fit with no duplicate while the player keeps his pick.
##
## `seed` makes the shuffle reproducible for a given round, so two runs of the
## same round show the same snakes (the A/B capture harness relies on it). Every
## visible snake gets a different character; the player always keeps his pick.
static func assign_round(snakes: Array, seed_value: int) -> void:
	var n := skins.size()
	if n == 0:
		return
	var pool: Array = []
	for i in n:
		if i != player_skin:
			pool.append(i)
	# Fisher-Yates over a deterministic LCG, independent of the core's RNG.
	var st := (seed_value ^ 0x9E3779B9) & 0xFFFFFFFF
	var i := pool.size() - 1
	while i > 0:
		st = (st * 1664525 + 1013904223) & 0xFFFFFFFF
		var j := int(st % (i + 1))
		var t = pool[i]
		pool[i] = pool[j]
		pool[j] = t
		i -= 1
	var cursor := 0
	for s in snakes:
		if s.is_player:
			if int(s.player_index) == 0:
				set_of(s, player_skin)
			else:
				# 2P: the second human gets the first non-picked character.
				set_of(s, int(pool[cursor % pool.size()]))
				cursor += 1
		else:
			set_of(s, int(pool[cursor % pool.size()]))
			cursor += 1


static func assign_one(s, idx: int) -> void:
	set_of(s, idx)


# ----------------------------------------------------------------- settings

static func load_settings() -> void:
	if _settings_loaded or skins.is_empty():
		return
	_settings_loaded = true
	var cfg := ConfigFile.new()
	if cfg.load(SETTINGS_PATH) != OK:
		return
	var slug := String(cfg.get_value("skin", "player", ""))
	var idx := index_of_slug(slug)
	if idx >= 0:
		player_skin = idx


static func save_settings() -> void:
	if skins.is_empty():
		return
	var cfg := ConfigFile.new()
	# Keep whatever else the file may hold (future settings) instead of
	# clobbering it: load first, then set our key.
	cfg.load(SETTINGS_PATH)
	cfg.set_value("skin", "player", String(get_skin(player_skin)["slug"]))
	cfg.save(SETTINGS_PATH)


static func set_player_skin(idx: int) -> void:
	player_skin = clampi(idx, 0, maxi(0, skins.size() - 1))
	save_settings()


static func step_player_skin(dir: int) -> void:
	if skins.is_empty():
		return
	set_player_skin((player_skin + dir + skins.size()) % skins.size())
